# =====================================
# React + Tailwind + Node.js .gitignore
# =====================================

# Dependencies
node_modules/

# Build outputs
build/
dist/
.cache/
.next/
out/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.log
*.bak
*.pid
*.seed
*.pid.lock

# Coverage and test output
coverage/
*.lcov

# Misc
*.lock
yarn.lock
package-lock.json
